{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Added to fix build issues */
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "index.tsx", "types.ts", "services", "pages", "hooks", "components", "constants.ts", "App.tsx", "contexts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
